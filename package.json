{
  "name": "final-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A solo slasher board game for the phone: survive the night, save the victims, kill the killer. An offline PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "icons": "tsx scripts/icons.ts",
    "e2e": "playwright test",
    "sim:smart": "tsx scripts/smartsim.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "ios-haptics": "3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
